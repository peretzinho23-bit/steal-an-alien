{
  "name": "steal-an-alien-bot",
  "version": "1.0.0",
  "description": "Discord server builder + community bot for the Roblox game Steal an Alien",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "pack": "node scripts/pack.js",
    "inspect": "node --env-file=.env src/cli.js inspect",
    "setup": "node --env-file=.env src/cli.js setup",
    "setup:dry": "node --env-file=.env src/cli.js setup --dry-run",
    "cleanup-roles": "node --env-file=.env src/cli.js cleanup-roles",
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=20.12"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "discord.js": "^14.27.0"
  }
}
