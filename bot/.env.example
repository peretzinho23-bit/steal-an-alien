DISCORD_TOKEN=your-bot-token-here
GUILD_ID=your-server-id-here

# Upstash Redis (free): the shared memory between the bot and the dashboard website.
# Use the SAME two values in the website's environment variables. Without them the bot still works,
# but the website cannot change its settings or see its warnings.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: a folder that survives restarts (XP and local settings are kept here). Default: ./data
# DATA_DIR=/home/container/data
