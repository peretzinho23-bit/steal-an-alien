# Copy to .env.local for running on your own computer (npm start). On Vercel set the same names in Project Settings -> Environment Variables.

# The server and the bot (same values as the bot)
GUILD_ID=your-server-id
DISCORD_BOT_TOKEN=your-bot-token

# Discord Developer Portal -> your application -> OAuth2
DISCORD_CLIENT_ID=your-application-id
DISCORD_CLIENT_SECRET=your-client-secret

# Any long random text (at least 24 characters). Signs the login cookie. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Upstash Redis (free): the shared memory between this site and the bot. Both need the SAME two values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: the public address of the site, if the automatic one is wrong (no trailing slash)
# BASE_URL=https://your-site.vercel.app

# Local testing only (never set these on Vercel): a fake admin login on localhost, and a file instead of Redis
# ALLOW_DEV_LOGIN=1
# KV_FILE=./.dev-kv.json
